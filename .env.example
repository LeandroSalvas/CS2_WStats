# =====================================================================
# CS2 WStats — copie para .env e preencha. Nunca versione o .env real.
# =====================================================================

# -------------------- Servidor dedicado de CS2 --------------------
CS2_SERVERNAME=Zueira CS2
CS2_PORT=27030
CS2_MAXPLAYERS=24
CS2_STARTMAP=de_dust2
RCON_PASSWORD=change_me_rcon
SERVER_PASSWORD=
SRCDS_TOKEN=change_me_generate_in_steamcommunity_dev_managegameservers
TV_ENABLE=1
TV_PORT=27031
STEAMAPPVALIDATE=1

# -------------------- Aplicação Web (cs2-web-app) --------------------
# Porta do host que expõe o painel (container escuta na 3000)
APP_PORT=8090

# Segredo compartilhado — ÚNICA fonte da verdade:
# é injetado automaticamente no gamestate_integration_custom.cfg pelo entry.sh
# do CS2 e validado no header X-Webhook-Secret / campo auth.token do GSI.
# Evite os caracteres | & \ no valor (quebram o sed de substituição).
WEBHOOK_SECRET=change_me_webhook_secret

# Delay do radar 2D ao vivo, em segundos (buffer FIFO em RAM)
GSI_DELAY_SECONDS=30

LOG_LEVEL=info

# -------------------- Auth RBAC / RCON --------------------
# Segredo de assinatura dos cookies JWT (gere com: openssl rand -hex 32)
AUTH_JWT_SECRET=change_me_jwt_secret
# Admin inicial criado no primeiro boot do cs2-web-app
ADMIN_EMAIL=admin@exemplo.local
ADMIN_PASSWORD=change_me_admin_password
# OAuth Google (opcional) — deixe false para usar apenas login local
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública base (sub-path atrás do proxy reverso), sem barra final
APP_PUBLIC_URL=https://exemplo.duckdns.org:4443/cs2
# Host/porta do RCON vistos DENTRO da rede docker (nome do serviço CS2)
RCON_HOST=cs2wstats
RCON_PORT=27015

# -------------------- PostgreSQL --------------------
POSTGRES_USER=wstats
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=wstats
